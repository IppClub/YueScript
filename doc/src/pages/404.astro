---
import StarlightPage from "@astrojs/starlight/components/StarlightPage.astro";

const base = import.meta.env.BASE_URL.replace(/\/?$/, "/");
const home = Astro.props.home ?? base;
---

<StarlightPage
  frontmatter={{
    title: "404",
    template: "splash",
    editUrl: false,
    pagefind: false,
    hero: {
      tagline: Astro.locals.t("404.text"),
      image: {
        html: `<img class="not-found-mascot" src="${base}image/mascot/electrichearts_20260211A_yuescript_xiaoyu.png" width="1071" height="1500" alt="" decoding="async" fetchpriority="high" />`,
      },
      actions: [
        {
          text: Astro.locals.t("yue.404.home"),
          link: home,
          icon: "left-arrow",
          attrs: { iconPlacement: "start" },
          variant: "primary",
        },
      ],
    },
  }}
/>

<style is:global>
  /* Keep the centered error layout separate from the home page hero. */
  :root:has(.not-found-mascot) {
    --sl-main-pad: 0;
  }

  .content-panel:has(.not-found-mascot) {
    --not-found-padding: clamp(1.5rem, 5svh, 3rem);
    padding-block: var(--not-found-padding);

    .sl-container {
      display: grid;
      align-content: center;
      min-height: calc(
        100svh - var(--sl-nav-height) - 2 * var(--not-found-padding)
      );
    }

    .hero {
      flex-direction: column;
      flex-wrap: nowrap;
      gap: var(--home-space-m);
      padding: 0;
    }

    .hero > .hero-html {
      order: 0;
      flex: none;
      width: 100%;
    }

    .hero > .hero-html img {
      width: clamp(8rem, 22svh, 13rem);
      max-height: none;
    }

    .hero > .stack {
      flex: none;
      width: 100%;
      gap: var(--home-space-m);
      text-align: center;
    }

    .hero .copy {
      align-items: center;
      gap: var(--home-space-s);
    }

    .hero h1 {
      font-size: clamp(3.5rem, 9vw, 6rem);
      line-height: 1;
    }

    .hero .tagline {
      max-width: 42ch;
      text-wrap: pretty;
    }

    .hero .actions {
      justify-content: center;
    }

    .hero .sl-link-button {
      min-height: 2.75rem;
    }

    .sl-markdown-content,
    footer {
      display: none;
    }
  }
</style>
