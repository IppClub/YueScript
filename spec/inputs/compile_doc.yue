outputFolder = ...

getFiles = (locale) ->
	locale = if locale == "en" then "" else "#{locale}/"
	[
		"doc/src/content/docs/#{locale}doc/index.md"
		"doc/src/content/docs/#{locale}doc/advanced/do.md"
		"doc/src/content/docs/#{locale}doc/advanced/line-decorators.md"
		"doc/src/content/docs/#{locale}doc/advanced/macro.md"
		"doc/src/content/docs/#{locale}doc/advanced/try.md"
		"doc/src/content/docs/#{locale}doc/data-structures/table-literals.md"
		"doc/src/content/docs/#{locale}doc/data-structures/comprehensions.md"
		"doc/src/content/docs/#{locale}doc/objects/object-oriented-programming.md"
		"doc/src/content/docs/#{locale}doc/objects/with-statement.md"
		"doc/src/content/docs/#{locale}doc/assignment/assignment.md"
		"doc/src/content/docs/#{locale}doc/assignment/varargs-assignment.md"
		"doc/src/content/docs/#{locale}doc/assignment/if-assignment.md"
		"doc/src/content/docs/#{locale}doc/assignment/destructuring-assignment.md"
		"doc/src/content/docs/#{locale}doc/assignment/the-using-clause-controlling-destructive-assignment.md"
		"doc/src/content/docs/#{locale}doc/getting-started/usage.md"
		"doc/src/content/docs/#{locale}doc/getting-started/introduction.md"
		"doc/src/content/docs/#{locale}doc/getting-started/installation.md"
		"doc/src/content/docs/#{locale}doc/control-flow/conditionals.md"
		"doc/src/content/docs/#{locale}doc/control-flow/for-loop.md"
		"doc/src/content/docs/#{locale}doc/control-flow/continue.md"
		"doc/src/content/docs/#{locale}doc/control-flow/switch.md"
		"doc/src/content/docs/#{locale}doc/control-flow/while-loop.md"
		"doc/src/content/docs/#{locale}doc/functions/function-stubs.md"
		"doc/src/content/docs/#{locale}doc/functions/backcalls.md"
		"doc/src/content/docs/#{locale}doc/functions/function-literals.md"
		"doc/src/content/docs/#{locale}doc/language-basics/whitespace.md"
		"doc/src/content/docs/#{locale}doc/language-basics/comment.md"
		"doc/src/content/docs/#{locale}doc/language-basics/attributes.md"
		"doc/src/content/docs/#{locale}doc/language-basics/operator.md"
		"doc/src/content/docs/#{locale}doc/language-basics/literals.md"
		"doc/src/content/docs/#{locale}doc/language-basics/module.md"
		"doc/src/content/docs/#{locale}doc/extras/license-mit.md"
		"doc/src/content/docs/#{locale}doc/advanced/the-yuescript-library.md"
	]
docs = [ ["codes_from_doc_#{locale}.lua", getFiles locale] for locale in *["en", "zh", "pt-br", "de", "id-id"]]
for [compiledFile, docFiles] in *docs
	codes = []
	for docFile in *docFiles
		close input = with? io.open docFile
			import "yue" as :to_lua
			text = \read "*a"
			for code in text\gmatch "```yuescript[\r\n]+(.-)```[^%w]"
				if result, err := to_lua code, implicit_return_root: false, reserve_line_number: false
					codes[] = result
				elseif not err\match "macro exporting module only accepts macro definition"
					print err
					os.exit 1
			for code in text\gmatch "```yue[\r\n]+(.-)```[^%w]"
				if result, err := to_lua code, implicit_return_root: false, reserve_line_number: false
					codes[] = result
				else
					print err
					os.exit 1
	close output = with io.open "#{outputFolder}/#{compiledFile}", "w+"
		\write table.concat codes
